# --- Database -------------------------------------------------------------
# SQLite by default so the app runs with zero infrastructure.
# For Postgres: set provider = "postgresql" in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/igcse_lab?schema=public"
DATABASE_URL="file:./dev.db"

# --- Owner ----------------------------------------------------------------
# The single account that can reach /admin. Ownership is pinned here rather
# than stored as a database role, so it cannot be granted from inside the app —
# not by a bug, not by an API call, not by a future feature.
# Register at /signup with this exact address to claim the console.
# Leave blank to disable the admin console entirely.
OWNER_EMAIL="you@example.com"

# --- Auth -----------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-before-deploying"

# --- AI provider ----------------------------------------------------------
# anthropic | google | none
# With "none" (or a missing key) the app falls back to the curriculum-grounded
# provider: it answers from the local content database and clearly tells the
# student that the live model is not configured. Nothing is faked.
AI_PROVIDER="anthropic"

# For AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# For AI_PROVIDER="google". Works with a Google AI Studio API key ("AIza...")
# or an OAuth access credential ("AQ..."), sent as the x-goog-api-key header.
GOOGLE_API_KEY=""

# Optional. Defaults: claude-sonnet-5 (anthropic) / gemini-flash-latest (google).
# Prefer an alias over a pinned version — Google retires specific versions, and
# a retired pin returns 404 on every request.
AI_MODEL=""

# Per-user request ceilings for the AI routes (rolling window).
AI_RATE_LIMIT_PER_MINUTE="12"
AI_RATE_LIMIT_PER_DAY="300"

# --- Payments (Razorpay) --------------------------------------------------
# Leave blank to run without payments: the trial and free tier still work, and
# the owner can grant Pro access to individual accounts from the owner console.
#
# Setup:
#   1. Create two subscription Plans in the Razorpay dashboard —
#      ₹299 monthly and ₹2,499 yearly — and paste their plan ids below.
#   2. Add a webhook pointing at https://your-domain/api/billing/webhook,
#      subscribed to the subscription.* and payment.failed events.
#   3. Put the webhook's signing secret in RAZORPAY_WEBHOOK_SECRET.
# Test keys start with rzp_test and never charge a real card.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_MONTHLY=""
RAZORPAY_PLAN_YEARLY=""

# --- Email ----------------------------------------------------------------
# Transactional email: password reset, welcome, payment receipt.
# Without these the app still runs, but "forgot password" returns a clear
# "email is not set up on this server" message rather than pretending to send.
# In development the reset link is printed to the server console instead.
#
# Uses Resend (https://resend.com) over its REST API — no SDK.
# EMAIL_FROM must be an address on a domain you have verified with the provider.
RESEND_API_KEY=""
EMAIL_FROM="IGCSE Science Lab <noreply@yourdomain.com>"

# Used to build links inside emails. Set to the public URL of the site.
APP_URL="http://localhost:3210"

# --- Storage --------------------------------------------------------------
# local | s3  (only "local" is implemented; see src/lib/storage.ts)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
