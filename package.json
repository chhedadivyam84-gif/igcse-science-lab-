{
  "name": "igcse-science-lab",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered learning platform for Cambridge IGCSE Physics 0625 and Chemistry 0620",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3210}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
